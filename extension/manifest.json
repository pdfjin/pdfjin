{
  "manifest_version": 3,
  "name": "PDFjin - Smart PDF Toolkit",
  "version": "1.0",
  "description": "Compress, Merge, and process PDFs directly from your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDFjin"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pdfjin-api-97530578628.us-central1.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.pdfjin.com/*"],
      "js": ["content.js"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://*.pdfjin.com/*"]
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
